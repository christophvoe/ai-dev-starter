# =============================================================================
# AI Dev Starter — Environment Variables
# =============================================================================
# 1. Copy this file: copy .env.example .env
# 2. Fill in your values below (never commit .env to git)
# 3. See README.md for setup details
# =============================================================================


# ── Medium Scraper ─────────────────────────────────────────────────────────────
# Only needed for --bookmarks and member-only articles.
# Tag scraping (--tag) works without any cookies.
#
# How to get cookies: F12 → Application → Cookies → https://medium.com
# Copy the values for: sid, uid, xsrf, cf_clearance
MEDIUM_COOKIES=sid=; uid=; xsrf=; cf_clearance=


# ── LLM Providers (optional) ──────────────────────────────────────────────────
# NOT needed for scraping. Only needed if you use BaseAgent for LLM chat.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=


# ── Telegram Bot (optional) ───────────────────────────────────────────────────
# Only needed for n8n daily digest notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_USER_ID=


# ── GitHub MCP (optional) ─────────────────────────────────────────────────────
# Enables commit history, PR creation, issue search in Copilot.
# GITHUB_TOKEN=
