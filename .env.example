# =============================================================================
# Environment Variables — TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# ── AI / LLM APIs ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Data / Market APIs (for trading/finance projects) ─────────────────────────
FMP_API_KEY=
NEWS_API_KEY=
FINLIGHT_API_KEY=

# ── Trading APIs ──────────────────────────────────────────────────────────────
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ── AI Tool Configuration ─────────────────────────────────────────────────────
# GitHub personal access token — enables GitHub MCP (commits, history, blame)
# Create at: https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=

# Brave Search API key — enables live web search in Copilot + Claude Code
# Free tier: 2000 queries/month at https://api.search.brave.com
BRAVE_API_KEY=

# ── Browser Automation (if using Selenium) ────────────────────────────────────
# Path to dedicated automation Chrome profile (separate from your main Chrome)
# Create with: python -m src.knowledge.medium_scraper --setup-auth
CHROME_AUTOMATION_PROFILE=%LOCALAPPDATA%\Google\Chrome\AutomationProfile

# ── n8n (if self-hosting) ─────────────────────────────────────────────────────
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=change-me
